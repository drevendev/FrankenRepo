# Node 24 reads this only after you copy it to .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
PUBLIC_WEB_ORIGIN=http://127.0.0.1:5173
API_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:3001,http://localhost:3001
MODEL_PROVIDER=disabled
# Choose an installed Gemma model explicitly. No auto-download.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
# Only set after owner authorization and verification of no-card Free access.
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_GEMMA_MODEL=@cf/google/gemma-4-26b-a4b-it
# Optional read-only public-repository token, never sent to the browser.
GITHUB_READ_TOKEN=
GITHUB_CACHE_TTL_SEC=43200
RATE_LIMIT_WINDOW_SEC=900
RATE_LIMIT_MAX=3
MAX_PARALLEL_RITUALS=1
# Durable reservations include initial + repair allowance; unknown stays reserved.
MODEL_CALLS_PER_DAY=20
# Optional private card archive. Leave URI empty to keep storage disabled.
# Quote the URI and URL-encode special characters in its password.
MONGODB_URI=
MONGODB_DB=frankenrepo
# Required with any real provider. Generate once and retain between restarts.
# At least 43 random characters, server-only. Render can generate this value.
# SESSION_SECRET=
ORCHESTRATOR=mastra
PUBLIC_SHARING_ENABLED=false
ULTRAMARINE_REVIEW_ENABLED=false
PAPER_INSTRUMENTS_API_KEY=
BACKBOARD_MEMORY_ENABLED=false
BACKBOARD_API_KEY=
# Set only after approving/seeding the notebook and checking its dated price.
# BACKBOARD_ASSISTANT_ID=
# BACKBOARD_MAX_READ_USD=0.02
TINKER_REVIEW_ENABLED=false
TINKER_API_KEY=
BROWSER_RESEARCH_ENABLED=false
BROWSERBASE_API_KEY=
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ORG=dreven
SENTRY_PROJECT=frankenrepo
# Operator commands only; no gallery, training or Browserbase background jobs.
